{
  "station": "Rap Lyrics Repo Digest",
  "feeds": {
    "bars_repo": {
      "plugin": "document_repo",
      "enabled": true,
      "repo_path": "D:/path/to/your/rap-lyrics-repo",
      "include_globs": [
        "*.txt",
        "*.md",
        "*.lrc"
      ],
      "exclude_globs": [
        ".git/*",
        "node_modules/*",
        "dist/*",
        "build/*"
      ],
      "max_files": 18,
      "max_chars_per_file": 700,
      "actor": "the lyric archive",
      "action": "write",
      "title_prefix": "verse file",
      "priority": 0.78
    }
  }
}
