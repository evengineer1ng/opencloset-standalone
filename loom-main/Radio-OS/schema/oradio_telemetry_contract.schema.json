{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radio-os.local/schema/oradio_telemetry_contract.schema.json",
  "title": "The Loom .oradio Telemetry Contract",
  "description": "Declares which telemetry sources an .oradio listens to, how they are normalized, and which targets or credentials are expected to resolve through the club model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "oradio.telemetry_contract.v1"
    },
    "mode": {
      "type": "string",
      "enum": [
        "push",
        "pull",
        "hybrid"
      ]
    },
    "polling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_poll_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "backoff_policy": {
          "type": "string",
          "enum": [
            "none",
            "linear",
            "exponential"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_shape": {
          "type": "string",
          "enum": [
            "radio_candidate_v1",
            "telemetry_event_v1"
          ]
        },
        "dedupe_window_sec": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "enabled"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "rss",
            "http_json",
            "bridge",
            "simulation",
            "sensor",
            "social",
            "market",
            "filesystem",
            "manual",
            "custom"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "transport": {
          "type": "string",
          "enum": [
            "poll",
            "stream",
            "file_watch",
            "command",
            "query"
          ]
        },
        "poll_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "target_ref": {
          "$ref": "#/$defs/clubRef"
        },
        "credential_ref": {
          "$ref": "#/$defs/clubRef"
        },
        "query": {
          "type": "object",
          "additionalProperties": true
        },
        "mapping": {
          "$ref": "#/$defs/mapping"
        },
        "heat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_priority": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "half_life_sec": {
              "type": "integer",
              "minimum": 1,
              "maximum": 604800
            },
            "interrupt_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "default": []
        }
      }
    },
    "clubRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "resolve"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "resolve": {
          "const": "club"
        },
        "kind": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title_field": {
          "type": "string",
          "maxLength": 120
        },
        "body_field": {
          "type": "string",
          "maxLength": 120
        },
        "timestamp_field": {
          "type": "string",
          "maxLength": 120
        },
        "priority_field": {
          "type": "string",
          "maxLength": 120
        },
        "id_field": {
          "type": "string",
          "maxLength": 120
        },
        "tag_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "default": []
        }
      }
    }
  }
}
