Thumbs.db
desktop.ini

# TLS certificates and private keys - NEVER commit these
*.crt
*.key
*.pem
*.p12
*.pfx

# OpenClaw local agent config (machine-specific)
.openclaw/

# User-specific (root-level scratch files only, not tests/ directory)
/test_*.py
/fix_*.py
ollamatest.py

# Large binary distributions (keep in releases, not repo)
voices/ffmpeg-*/
voices/piper_windows_*/
voices/piper_macos_*/
voices/piper_linux_*/
# Voice models and Piper binaries - download via setup.py
voices/piper/
