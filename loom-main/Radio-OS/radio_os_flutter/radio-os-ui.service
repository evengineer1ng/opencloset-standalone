[Unit]
Description=Radio OS Flutter UI
After=network.target

[Service]
Type=simple
User=airfryer
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=LIBGL_ALWAYS_SOFTWARE=1
ExecStart=/home/airfryer/radio_os_flutter/build/linux/arm64/release/bundle/radio_os_flutter
Restart=always
RestartSec=3
StandardOutput=append:/home/airfryer/radio_os_flutter.log
StandardError=append:/home/airfryer/radio_os_flutter.log

[Install]
WantedBy=multi-user.target
